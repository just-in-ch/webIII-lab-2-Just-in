rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Usuarios ----------------
    match /datosUsuarios/{docId} {
      allow read: if request.auth != null;

      // fechaCreacion y ultAcceso deben ser la hora del servidor
      allow create: if request.auth != null &&
                       request.resource.data.idemp == request.auth.uid &&
                       request.resource.data.usuario is string &&
                       request.resource.data.email is string &&
                       request.resource.data.fechaCreacion == request.time &&
                       request.resource.data.ultAcceso == request.time;

      // al ingresar solo se puede cambiar ultAcceso, y solo el propio usuario
      allow update: if request.auth != null &&
                       resource.data.idemp == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultAcceso']) &&
                       request.resource.data.ultAcceso == request.time;

      allow delete: if false;
    }

    // ---------------- Signos zodiacales ----------------
    function signoValido(d) {
      return d.posic is int && d.posic >= 1 && d.posic <= 12 &&
             d.signo is string && d.signo.size() > 0 &&
             d.rango is string &&
             d.elemento in ['Fuego', 'Tierra', 'Aire', 'Agua'] &&
             d.astro is string && d.astro.size() > 0 &&
             d.piedra is string && d.piedra.size() > 0 &&
             d.url is string;
    }

    match /datosZodiaco/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && signoValido(request.resource.data);
      allow update: if request.auth != null && signoValido(request.resource.data);
      allow delete: if false;
    }
  }
}
